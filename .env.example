# Copy to .env (repo root). Never commit.
GEMINI_API_KEY=

# Comma-separated model chain. First one that answers wins; a 503 on one
# falls through to the next. flash-lite is faster and less contended.
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# Set to 0 if your model rejects thinkingConfig (400 errors in logs)
GEMINI_THINKING_OFF=0

# Timeouts, ms. The case call writes ~4k chars of JSON and takes ~6s.
CASE_TIMEOUT_MS=20000
CAPTURE_TIMEOUT_MS=12000
SCAN_TIMEOUT_MS=12000

# Force the offline fixture path (great for UI work / stage backup)
DEMO_ONLY=0

PORT=8787
